# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: public base URL for invitation links (defaults to the Vercel
# production URL, then to the request's host).
# NEXT_PUBLIC_SITE_URL=https://invitations.example.com

# Email reminders (stage 4). Configure ONE of:
# 1) Resend (https://resend.com). Until your domain is verified, Resend only
#    delivers to your own account's address from onboarding@resend.dev.
# RESEND_API_KEY=re_...
# 2) SMTP, e.g. Gmail with an App Password (about 500 emails a day):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
#
# Sender shown to guests. With Gmail it must be the same address as SMTP_USER.
# EMAIL_FROM="Business name <reminders@your-domain.co.il>"
# EMAIL_REPLY_TO=office@your-domain.co.il
#
# Without either provider, development logs emails instead of sending them;
# EMAIL_DRY_RUN=1 forces that anywhere.

# Protects /api/cron/reminders. Vercel Cron sends it automatically.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# How often the reminder job runs, in hours. 24 for Vercel Hobby (daily);
# 1 if it runs hourly (Vercel Pro or an external cron service).
# REMINDER_RUN_INTERVAL_HOURS=24
